{
  "version": "0.0.1",
  "autoPort": true,
  "configurations": [
    {
      "name": "design-kit",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "http-server", "design", "-c-1", "--silent"],
      "port": 4180
    },
    {
      "name": "console",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--workspace", "@printorian/console"],
