    {
      "name": "web-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--workspace",
        "@printorian/web",
        "--",
        "--port",
        "5183"
      ],
      "port": 5183
    }
