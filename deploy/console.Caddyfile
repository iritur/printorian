# The farm console, served from the on-prem server on the LAN (ADR-0016).
#
# Caddy serves the SPA bundle and proxies the API from the same origin, which is
# the whole point: same-origin means the httpOnly session cookie travels with
# every request and with the WebSocket handshake, so the console needs no CORS
# entry, no bearer token, and no second auth path. ADR-0016 records what the
# cross-origin alternative cost when the console was an Electron app.
#
# Plain HTTP on 8080. TLS terminates at the edge for the storefront; the console
# never leaves the LAN, and giving it a certificate for a name only the farm
# resolves buys a warning rather than a guarantee. Revisit if the LAN stops being
# trusted — that is a network decision, not a Caddy one.
#
# And that is also why there is no `Strict-Transport-Security` here: HSTS on a
# plain-HTTP origin is either ignored or a way to make the console unreachable.
# It belongs on the storefront's edge, where TLS actually terminates (Stage 3).

:8080 {
	encode zstd gzip

	# `handle_path` strips the /api prefix before proxying, which is exactly what
	# the Vite dev proxy does (frontend/apps/console/vite.config.ts). Development
	# and production disagreeing about the prefix is a class of bug that only
	# appears after deploy, so they are kept identical on purpose.
	#
	# WebSockets need no special handling: /api/ws/events arrives as an upgrade
	# request and Caddy proxies it as one.
	handle_path /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /srv

		# Vite emits content-hashed asset filenames, so those may be cached hard.
		# index.html must not be: it is the document naming the current hashes,
		# and a cached copy pins a browser to a deploy that no longer exists.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		header {
			X-Content-Type-Options nosniff
			Referrer-Policy same-origin
			-Server

			# A content policy, which the console had none of. The bundle is
			# self-contained — Vite emits hashed local assets, the fonts are
			# vendored with the design kit, and the only network the app makes is
			# to `/api` on this same origin — so the policy can be this tight
			# without a single exception, and an injected `<script src>` has
			# nowhere to load from.
			#
			# `connect-src 'self'` covers the live WebSocket: CSP3 makes `'self'`
			# match `ws://` on the same host as an `http://` document, which is
			# what `/api/ws/events` is. Worth knowing rather than rediscovering,
			# because a browser that predates that reading would silently show a
			# console whose boards never update — the exact failure the relay was
			# built to remove.
			#
			# `'unsafe-inline'` on styles only: the app sets inline `style`
			# attributes for the things that are genuinely dynamic (a progress
			# width, a material's colour swatch). Scripts get no such allowance,
			# which is the half that matters for injection.
			# `font-src` allows `data:` because Vite inlines the interface font
			# into the CSS bundle. Without it the browser blocks the font and the
			# console renders in a fallback face -- visible only when served
			# through this Caddyfile, since the dev server sends no CSP at all.
			# `data:` is already allowed for images; fonts cannot execute, so the
			# same allowance carries the same (negligible) risk.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"

			# The console is a tool, never something to be framed by a page a
			# person was led to. `frame-ancestors` above says the same thing to a
			# modern browser; this covers the rest.
			X-Frame-Options DENY
		}

		# SPA routing: unknown paths are client-side routes, not 404s.
		try_files {path} /index.html
		file_server
	}
}
