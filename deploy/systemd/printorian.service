# The farm itself: the compose stack, brought up at boot and kept up.
#
# `Type=oneshot` with `RemainAfterExit=yes` rather than a long-running unit,
# because the thing that actually supervises the containers is Docker's own
# restart policy (`restart: unless-stopped` in the compose file). systemd's job
# here is to bring the stack up at boot and take it down on shutdown; two
# supervisors fighting over the same containers is how a restart loop starts.

[Unit]
Description=Printorian farm stack
Documentation=https://github.com/dimmus/printorian/blob/main/docs/INFRASTRUCTURE.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/printorian/repo

# `--wait` blocks until every container with a healthcheck reports healthy, so a
# farm that comes up broken fails the unit rather than reporting active while
# serving nothing.
ExecStart=/usr/bin/docker compose -f deploy/compose.prod.yml up -d --wait
ExecStop=/usr/bin/docker compose -f deploy/compose.prod.yml down

# Generous: `--wait` covers database migration on first boot after an upgrade,
# and a migration on a farm with a year of telemetry is not fast.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
